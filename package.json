{
  "name": "flatline",
  "private": true,
  "version": "0.1.0",
  "description": "Motion-graphics music videos for \"Flatline\" (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "stills:small": "python3 scripts/make_small_stills.py",
    "typecheck": "tsc --noEmit",
    "render:full-preview": "remotion render Flatline0 out/flatline0-preview.mp4 --scale=0.5 --crf=26",
    "render:full": "remotion render Flatline0 out/flatline0.mp4",
    "render:vertical": "remotion render Flatline0Vertical out/flatline0-vertical.mp4",
    "render:opening": "remotion render ScreenOpening out/opening.mp4",
    "render:opening-preview": "remotion render ScreenOpening out/opening-preview.mp4 --scale=0.5 --crf=28"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/space-grotesk": "5.2.8",
    "@remotion/cli": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
